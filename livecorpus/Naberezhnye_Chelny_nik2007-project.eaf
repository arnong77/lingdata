    <TIER ANNOTATOR="arnong77" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment" PARTICIPANT="@nik2007f" TIER_ID="gestComment@nik2007f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2438"
                TIME_SLOT_REF1="ts473" TIME_SLOT_REF2="ts479">
                <ANNOTATION_VALUE>в данном случае, мне кажется, что это просто физиологический жест (почёсывание)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2441"
                TIME_SLOT_REF1="ts731" TIME_SLOT_REF2="ts733">
                <ANNOTATION_VALUE>здесь тоже есть физиологический жест (почёсывание),но в данном случае, мне кажется,что его можно разметить в качестве адаптора (задумчивость)</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2445"
                TIME_SLOT_REF1="ts774" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>Нурия продолжает удерживать голову,смотря наверх</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2451"
                TIME_SLOT_REF1="ts820" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>я не уверен, но, мне кажется, что Нурия немного наклонила голову,смотря вниз</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2456"
                TIME_SLOT_REF1="ts936" TIME_SLOT_REF2="ts941">
                <ANNOTATION_VALUE>возможно, это еще может быть адаптором со значением не большой неуверенности</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2512"
                TIME_SLOT_REF1="ts1029" TIME_SLOT_REF2="ts1045">
                <ANNOTATION_VALUE>здесь тоже разметил в слое gestBody, так как ноги полностью не видны</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
